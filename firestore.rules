rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Helper Functions & Authentication Checks
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Cryptographic and Authoritative Super Admin check
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && (
          ('email' in request.auth.token && request.auth.token.email == 'zakaria.fahmy26@gmail.com') ||
          ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
          ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN')
        )) ||
        (hasUserDoc() && (
          ('isSuperAdmin' in getUserData() && getUserData().isSuperAdmin == true) ||
          getUserData().role == 'SUPER_ADMIN' ||
          getUserData().role == 'admin'
        ))
      );
    }

    function isUserActive() {
      return isSuperAdmin() || (hasUserDoc() && (!('status' in getUserData()) || (getUserData().status != 'disabled' && getUserData().status != 'suspended')));
    }

    function isCompanyAdminOrSuper() {
      return isSuperAdmin() || (hasUserDoc() && (
        getUserData().role == 'COMPANY_ADMIN' ||
        getUserData().role == 'admin'
      ) && isUserActive());
    }

    function isOperationsManagerOrHigher() {
      return isSuperAdmin() || (hasUserDoc() && (
        getUserData().role == 'COMPANY_ADMIN' ||
        getUserData().role == 'OPERATIONS_MANAGER' ||
        getUserData().role == 'admin' ||
        getUserData().role == 'manager'
      ) && isUserActive());
    }

    function isSupervisorOrHigher() {
      return isSuperAdmin() || (hasUserDoc() && (
        getUserData().role == 'COMPANY_ADMIN' ||
        getUserData().role == 'OPERATIONS_MANAGER' ||
        getUserData().role == 'SUPERVISOR' ||
        getUserData().role == 'admin' ||
        getUserData().role == 'manager' ||
        getUserData().role == 'operation'
      ) && isUserActive());
    }

    function isTeamMember() {
      return isSuperAdmin() || (hasUserDoc() && isUserActive());
    }

    // Tenant access: user can access their assigned company, or if Super/Admin, or if newly authenticated
    function canAccessCompany(companyId) {
      return isSuperAdmin() || (
        isTeamMember() && (
          isCompanyAdminOrSuper() ||
          !hasUserDoc() ||
          !('companyId' in getUserData()) ||
          getUserData().companyId == '' ||
          getUserData().companyId == 'all' ||
          getUserData().companyId == companyId
        )
      );
    }

    // Document must belong to the tenant company on create
    function isValidCompanyForCreate(companyId) {
      return !('companyId' in request.resource.data) || request.resource.data.companyId == companyId;
    }

    // Document companyId CANNOT be modified or switched to another tenant on update
    function isImmutableCompanyId() {
      return !('companyId' in request.resource.data) ||
        !('companyId' in resource.data) ||
        request.resource.data.companyId == resource.data.companyId;
    }

    // -------------------------------------------------------------------------
    // Root Users Collection (Centralized auth profiles & RBAC)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Creation: user registering themselves or Company Admin adding within tenant
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role != 'SUPER_ADMIN') && (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false)) ||
        (isCompanyAdminOrSuper() && (!('role' in request.resource.data) || request.resource.data.role != 'SUPER_ADMIN') && (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false)) ||
        isSuperAdmin()
      );

      // Update: Users cannot touch protected fields (role, companyId, permissions, isSuperAdmin, status)
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isCompanyAdminOrSuper() &&
          resource.data.companyId == getUserData().companyId &&
          request.resource.data.role != 'SUPER_ADMIN' &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false) &&
          request.resource.data.companyId == resource.data.companyId
        ) ||
        (request.auth.uid == userId &&
          resource != null &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId', 'permissions', 'customPermissions', 'isSuperAdmin', 'status', 'uid'])
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (isCompanyAdminOrSuper() &&
          request.auth.uid != userId &&
          resource.data.companyId == getUserData().companyId &&
          resource.data.role != 'SUPER_ADMIN' &&
          (!('isSuperAdmin' in resource.data) || resource.data.isSuperAdmin == false)
        )
      );
    }

    // -------------------------------------------------------------------------
    // Multi-Tenant Company Hierarchy: /companies/{companyId}/...
    // -------------------------------------------------------------------------
    match /companies/{companyId} {
      allow read: if isSignedIn() && canAccessCompany(companyId);
      allow write: if isCompanyAdminOrSuper() && canAccessCompany(companyId) && isValidId(companyId);

      // Subcollection: users
      match /users/{userId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isCompanyAdminOrSuper() && canAccessCompany(companyId);
      }

      // Subcollection: vehicles
      match /vehicles/{vehicleId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isSupervisorOrHigher() && canAccessCompany(companyId) && isValidId(vehicleId) && isValidCompanyForCreate(companyId);
        allow update: if isSupervisorOrHigher() && canAccessCompany(companyId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: vehicleDocuments
      match /vehicleDocuments/{docId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isSupervisorOrHigher() && canAccessCompany(companyId) && isValidId(docId) && isValidCompanyForCreate(companyId);
        allow update: if isSupervisorOrHigher() && canAccessCompany(companyId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: drivers
      match /drivers/{driverId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isSupervisorOrHigher() && canAccessCompany(companyId) && isValidId(driverId) && isValidCompanyForCreate(companyId);
        allow update: if isSupervisorOrHigher() && canAccessCompany(companyId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: tasks
      match /tasks/{taskId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isSupervisorOrHigher() && canAccessCompany(companyId) && isValidId(taskId) && isValidCompanyForCreate(companyId);
        allow update: if isTeamMember() && canAccessCompany(companyId) && isValidId(taskId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: deals (Sales pipeline deals & RFPs)
      match /deals/{dealId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(dealId) && isValidCompanyForCreate(companyId);
        allow update: if isTeamMember() && canAccessCompany(companyId) && isValidId(dealId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);

        // Nested subcollection: activities (Deal audit trail and activity log)
        match /activities/{activityId} {
          allow read: if isSignedIn() && canAccessCompany(companyId);
          allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(activityId);
          allow update, delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
        }
      }

      // Subcollection: trips
      match /trips/{tripId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(tripId) && isValidCompanyForCreate(companyId);
        allow update: if isTeamMember() && canAccessCompany(companyId) && isValidId(tripId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: maintenance
      match /maintenance/{maintenanceId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(maintenanceId) && isValidCompanyForCreate(companyId);
        allow update: if isTeamMember() && canAccessCompany(companyId) && isValidId(maintenanceId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: fuel
      match /fuel/{fuelId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(fuelId) && isValidCompanyForCreate(companyId);
        allow update: if isTeamMember() && canAccessCompany(companyId) && isValidId(fuelId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: expenses
      match /expenses/{expenseId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(expenseId) && isValidCompanyForCreate(companyId);
        allow update: if isTeamMember() && canAccessCompany(companyId) && isValidId(expenseId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: locations
      match /locations/{locationId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isSupervisorOrHigher() && canAccessCompany(companyId) && isValidId(locationId) && isValidCompanyForCreate(companyId);
        allow update: if isSupervisorOrHigher() && canAccessCompany(companyId) && isImmutableCompanyId();
        allow delete: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
      }

      // Subcollection: regions
      match /regions/{regionId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isOperationsManagerOrHigher() && canAccessCompany(companyId) && isValidId(regionId);
      }

      // Subcollection: areas
      match /areas/{areaId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isOperationsManagerOrHigher() && canAccessCompany(companyId) && isValidId(areaId);
      }

      // Subcollection: branches
      match /branches/{branchId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isOperationsManagerOrHigher() && canAccessCompany(companyId) && isValidId(branchId);
      }

      // Subcollection: automationRules
      match /automationRules/{ruleId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isCompanyAdminOrSuper() && canAccessCompany(companyId) && isValidId(ruleId) && isValidCompanyForCreate(companyId);
      }

      // Subcollection: automationExecutions
      match /automationExecutions/{execId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(execId) && isValidCompanyForCreate(companyId);
        allow update, delete: if isCompanyAdminOrSuper() && canAccessCompany(companyId);
      }

      // Subcollection: notifications
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isTeamMember() && canAccessCompany(companyId) && isValidId(notificationId);
      }

      // Subcollection: auditLogs (Strictly append-only by team members)
      match /auditLogs/{logId} {
        allow read: if isOperationsManagerOrHigher() && canAccessCompany(companyId);
        allow create: if isTeamMember() && canAccessCompany(companyId) && isValidId(logId);
        allow update, delete: if false; // Append-only immutable log
      }

      // Subcollection: settings
      match /settings/{settingId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isCompanyAdminOrSuper() && canAccessCompany(companyId) && isValidId(settingId);
      }

      // Subcollection: migration (Super Admin only)
      match /migration/{statusId} {
        allow read: if isSignedIn() && canAccessCompany(companyId);
        allow write: if isSuperAdmin();
      }

      // Subcollection: aiConversations
      match /aiConversations/{convId} {
        allow read, write: if isSignedIn() && canAccessCompany(companyId);

        match /messages/{messageId} {
          allow read, write: if isSignedIn() && canAccessCompany(companyId);
        }
      }
    }

    // -------------------------------------------------------------------------
    // Backward Compatibility: Legacy Root Collections
    // Write access is completely blocked for clients (writes must be in companies/{companyId}).
    // Read is strictly scoped to user's companyId.
    // -------------------------------------------------------------------------
    function canAccessLegacyDoc() {
      return isSuperAdmin() || (
        isSignedIn() &&
        hasUserDoc() &&
        ('companyId' in getUserData()) &&
        getUserData().companyId != '' &&
        (resource == null || !('companyId' in resource.data) || resource.data.companyId == getUserData().companyId)
      );
    }

    match /regions/{regionId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /areas/{areaId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /locations/{locationId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /tasks/{taskId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /sales_deals/{dealId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /vehicle_documents/{docId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /drivers/{driverId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /trips/{tripId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /fuel/{fuelId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /maintenance/{maintenanceId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /automation_rules/{ruleId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /automation_executions/{execId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /fleet_notifications/{notificationId} {
      allow read: if canAccessLegacyDoc();
      allow write: if isSuperAdmin();
    }

    match /audit_logs/{auditId} {
      allow read: if canAccessLegacyDoc() && isOperationsManagerOrHigher();
      allow write: if isSuperAdmin();
    }

    // System connectivity test document
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
