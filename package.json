    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.4.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "vite": "^6.2.3",
